# Copy to apps/storefront/.env.local (or set in Vercel → Project → Settings → Environment Variables)
API_URL=http://localhost:4000
# Origin of the Tenant Admin app (allowed to embed /preview and drive it via postMessage)
ADMIN_ORIGIN=http://localhost:3001
NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:3001
# Must equal ROOT_DOMAIN on the API. Used for path-based store URLs (/s/<slug>).
STORE_ROOT_DOMAIN=localhost
# Must match REVALIDATE_SECRET on the API
REVALIDATE_SECRET=
