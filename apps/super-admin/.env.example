# Copy to apps/super-admin/.env.local
API_URL=http://localhost:4000
NEXT_PUBLIC_STOREFRONT_URL=http://{slug}.localhost:3000
# On Vercel without a custom domain, use path-based store URLs:
# NEXT_PUBLIC_STOREFRONT_URL=https://your-storefront.vercel.app/s/{slug}
# Optional comma-separated allow-list of operator IPs (also set PLATFORM_IP_ALLOWLIST on the API)
OPS_IP_ALLOWLIST=
