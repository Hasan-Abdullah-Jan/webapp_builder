# Copy to .env and fill in. Never commit .env.
# Atlas: Database → Connect → Drivers gives the SRV string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.<id>.mongodb.net/website_builder
MONGODB_URI=
MONGODB_DB_NAME=website_builder
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
PORT=4000
NODE_ENV=development
