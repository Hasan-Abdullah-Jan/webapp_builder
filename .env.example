# Copy to .env (repo root) and fill in. Never commit .env.
# The API reads this file. Each Next.js app reads its own apps/<app>/.env.local (see README).

# --- Database -------------------------------------------------------------
# Atlas: Database → Connect → Drivers gives the connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.<id>.mongodb.net/website_builder
# (remove the < > around user and password). Local: mongodb://127.0.0.1:27017
MONGODB_URI=
MONGODB_DB_NAME=website_builder

# --- API ------------------------------------------------------------------
# At least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
PORT=4000
NODE_ENV=development
# Stores live at <slug>.<ROOT_DOMAIN>. Use "localhost" in dev, e.g. quickstore.pk in production.
ROOT_DOMAIN=localhost
# Storefront cache purge after publish/suspend (same secret in apps/storefront/.env.local).
STOREFRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=
# Optional: comma-separated IPs allowed to call /v1/platform (Super Admin).
PLATFORM_IP_ALLOWLIST=
# Number of trusted proxy hops in front of the API (for client IPs in rate limits).
TRUST_PROXY_HOPS=1
